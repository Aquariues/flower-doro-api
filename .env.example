APP_ENV=development
APP_NAME=FlowerDoro API
HTTP_ADDR=:8080

DATABASE_URL=postgres://flowerdoro:flowerdoro@localhost:5433/flowerdoro?sslmode=disable
ADMIN_DATABASE_URL=postgres://flowerdoro:flowerdoro@localhost:5433/flowerdoro?sslmode=disable

GOADMIN_PREFIX=admin
GOADMIN_TITLE=FlowerDoro Admin
GOADMIN_LANGUAGE=en
AUTO_MIGRATE=true

# Flower images should be uploaded to S3 or an S3-compatible bucket.
# The API stores final URLs in flowers.image_url and flowers.thumbnail_url.
S3_REGION=ap-southeast-1
S3_BUCKET=flowerdoro-assets
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
FLOWER_IMAGE_BASE_URL=https://cdn.example.com/flowers
